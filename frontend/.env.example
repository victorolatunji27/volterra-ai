# Copy to .env.local
# Base URL of the FastAPI backend. When unreachable, the app falls back to
# the design's illustrative demo data.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase auth (dashboard -> Settings -> API). When unset, the app runs in
# demo mode: auth flows simulate success and no routes are gated.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sentry error tracking (sentry.io project DSN). Empty = disabled.
NEXT_PUBLIC_SENTRY_DSN=
