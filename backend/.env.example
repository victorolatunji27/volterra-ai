# ── Database (Supabase Postgres) ─────────────────────────────────────────────
# Pieces of the connection URL; the password is percent-encoded at runtime in
# db/database.py, so paste it raw here. Use the "Transaction" pooler host for
# Railway deployments.
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=db.xxxxxxxxxxxx.supabase.co
DB_PORT=5432
DB_NAME=postgres

# ── Anthropic (console.anthropic.com → API Keys) ─────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── NewsAPI (newsapi.org → free key, 100 req/day) ───────────────────────────
NEWSAPI_KEY=your-newsapi-key
NEWSAPI_BASE_URL=https://newsapi.org/v2

# ── Upstash Redis (upstash.com → database → REST API section) ───────────────
UPSTASH_REDIS_REST_URL=https://xxxxxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# ── Supabase Auth — verifies user JWTs on protected routes ──────────────────
# Modern Supabase projects sign tokens asymmetrically (ES256) — set
# SUPABASE_URL and the backend verifies against the project's public JWKS
# endpoint, no secret needed. Check dashboard → Settings → API → JWT Keys to
# see which signing mode your project uses.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Legacy fallback ONLY: some older projects still sign with a shared HS256
# secret (dashboard → Settings → API → JWT Secret). Leave blank if
# SUPABASE_URL is set and your project uses JWKS/ES256 — that path is tried
# first and this is unused.
SUPABASE_JWT_SECRET=

# ── Resend (resend.com → API Keys) — email digest + alerts ──────────────────
RESEND_API_KEY=re_...
# Optional: the From address for digests (domain must be verified in Resend)
DIGEST_FROM_ADDRESS=VolterraAI <digest@volterraai.com>
# Optional: the From address for plain-text strategy alert emails
ALERT_FROM_ADDRESS=alerts@volterraai.com

# ── Sentry (sentry.io → project → DSN). Optional — skipped if unset ─────────
SENTRY_DSN=

# ── App config ───────────────────────────────────────────────────────────────
# Public site URL used for links inside digest emails (no trailing slash)
APP_BASE_URL=https://volterraai.com
# Paid Pro tier. Leave false for the free-tier launch: every user then gets
# the digest and the test-alert endpoint. Flip together with the frontend's
# NEXT_PUBLIC_PAYWALL_ENABLED once Stripe exists.
BILLING_ENABLED=false
# Comma-separated list of origins allowed by CORS. Defaults to local dev +
# the production site when unset.
ALLOWED_ORIGINS=http://localhost:3000,https://volterraai.com,https://www.volterraai.com
# "development" locally, "production" in Railway
ENVIRONMENT=development
# Set to "false" to run the API without the in-process APScheduler jobs
ENABLE_SCHEDULER=true

# ── Tradier (developer.tradier.com) — the production market-data source ─────
# Setting a key switches options flow, quotes, and price history off yfinance.
# Sandbox is delayed data; use the production base URL for live quotes.
TRADIER_API_KEY=
TRADIER_BASE_URL=https://sandbox.tradier.com/v1
# Optional override: tradier | yfinance. Defaults to tradier whenever a key is
# present, so this is only needed to force yfinance with a key configured.
MARKET_DATA_PROVIDER=
